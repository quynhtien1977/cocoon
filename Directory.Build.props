<Project>
  <PropertyGroup Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' == 'true'">
    <BaseIntermediateOutputPath>obj-docker/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin-docker/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;**/bin-docker/**;**/obj-docker/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
